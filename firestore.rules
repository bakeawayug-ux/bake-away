rules_version = '2';

// Each signed-in person can read and write only their own records, kept under users/{their id}.
// Nobody else, signed in or not, can read or write them. There is no other path in the database.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
