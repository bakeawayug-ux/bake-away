{
  "name": "bake-away",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Bake Away and Hardware records for Evelyn: orders, customers, expenses, stock and reports. Works on iPhone (home screen app) and on a laptop.",
  "scripts": {
    "dev": "vite --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 5181 --strictPort",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-bake-away",
    "dev:emulator": "vite --mode emulator --port 5182 --strictPort"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
